<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="simple_gui_row_cache" uuid="8C2F41D6-5B7A-4E93-9D10-3A6E2F84B5C1" library_target="simple_gui_row_cache">
	<description>A session row cache for simple_gui's lazy tables (1f): every row brought into view is kept, so the program makes each row once. GUI_ROW_CACHE over a GUI_ROW_STORE; the default store is a scratch file with an in-memory index (no SQLite). See docs/choosing-a-row-store.md.</description>

	<target name="simple_gui_row_cache">
		<root all_classes="true"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\..*$</exclude>
		</file_rule>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="dead_code_removal" value="feature"/>
		<capability>
			<concurrency support="scoop" use="scoop"/>
			<void_safety support="all"/>
		</capability>
		<external_include location="$(SIMPLE_EIFFEL)/simple_gui/row_cache/Clib"/>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="simple_gui" location="$SIMPLE_EIFFEL\simple_gui\simple_gui.ecf"/>
		<library name="simple_file" location="$SIMPLE_EIFFEL\simple_file\simple_file.ecf"/>
		<cluster name="row_cache" location=".\src\" recursive="true"/>
	</target>

	<target name="simple_gui_row_cache_tests" extends="simple_gui_row_cache">
		<root class="ROW_CACHE_TEST_APP" feature="make"/>
		<setting name="console_application" value="true"/>
		<cluster name="testing" location=".\testing\" recursive="true"/>
	</target>
</system>
